#include <winres.h>

#define VER_MAJOR 1
#define VER_MINOR 0
#define VER_PATCH 0

1 ICON "APB.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DoraNeko"
            VALUE "FileDescription", "Anti-Productivity Bubbles (APB) - a bubble overlay that lowers your efficiency"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "APB"
            VALUE "LegalCopyright", "Copyright (c) 2026 DoraNeko. MIT License."
            VALUE "OriginalFilename", "APB.exe"
            VALUE "ProductName", "Anti-Productivity Bubbles"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
